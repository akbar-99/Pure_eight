{
  "name": "pure-eight",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@pure-eight/web",
    "dev:staff": "turbo dev --filter=@pure-eight/mobile-staff",
    "dev:customer": "turbo dev --filter=@pure-eight/mobile-customer"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react-native-worklets": "^0.9.1"
  }
}
